{
  "name": "sumark",
  "version": "0.3.2",
  "description": "SuMark - A powerful WYSIWYG Markdown editor",
  "main": "src/index.html",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev --no-watch",
    "dev:watch": "tauri dev",
    "build": "tauri build",
    "build:mac": "tauri build --target universal-apple-darwin",
    "build:win": "tauri build --target x86_64-pc-windows-msvc",
    "build:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "test": "npm run test:build && npm run test:e2e",
    "test:build": "tauri build",
    "test:e2e": "wdio run wdio.conf.js",
    "test:e2e:watch": "wdio run wdio.conf.js --watch"
  },
  "keywords": [
    "markdown",
    "editor",
    "tauri",
    "desktop-app"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/cli": "^1.6.3",
    "@testing-library/dom": "^10.4.1",
    "@wdio/cli": "^9.24.0",
    "@wdio/local-runner": "^9.24.0",
    "@wdio/mocha-framework": "^9.24.0",
    "@wdio/spec-reporter": "^9.24.0",
    "expect-webdriverio": "^5.6.4",
    "jest": "^30.2.0",
    "jsdom": "^28.0.0",
    "webdriverio": "^9.24.0"
  }
}
