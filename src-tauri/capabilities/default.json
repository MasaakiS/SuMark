{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main SuMark window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:app:allow-name",
    "core:app:allow-version",
    "core:window:allow-set-title",
    "dialog:default",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        "**"
      ]
    },
    "opener:default",
    "opener:allow-open-path"
  ]
}